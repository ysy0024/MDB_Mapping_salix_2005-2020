// 对一个按时间排序的 ImageCollection 实现 NDVI 差分（滑动窗口）
function diffImageCollection(ic) {
  var list = ic.toList(ic.size());
  var diffList = ee.List.sequence(1, list.size().subtract(1)).map(function(i) {
    i = ee.Number(i);
    var imgNow  = ee.Image(list.get(i));
    var imgPrev = ee.Image(list.get(i.subtract(1)));
    var diff = imgNow.subtract(imgPrev).rename('NDVI_diff');
    var time = imgNow.get('system:time_start');
    return diff.set('system:time_start', time);
  });
  return ee.ImageCollection(diffList);
}

