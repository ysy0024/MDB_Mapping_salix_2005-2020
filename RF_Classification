// ========== 计算 NDWI (L7) ==========
// 统一的 NDWI 计算函数（L5/L7：直接；L8：先 OLI→ETM 等效）
function ndwi_L57(img) {
  img = maskL2(img);
  var nir  = img.select('SR_B4').multiply(0.0000275).add(-0.2);
  var swir = img.select('SR_B5').multiply(0.0000275).add(-0.2);
  return nir.subtract(swir).divide(nir.add(swir)).rename('NDWI');
}

function ndwi_L8(img) {
  img = maskL2(img);

  // OLI 反射率
  var nir_oli   = img.select('SR_B5').multiply(0.0000275).add(-0.2);
  var swir1_oli = img.select('SR_B6').multiply(0.0000275).add(-0.2);

  // 选择一组 L8→ETM 等效系数（与你现有代码保持一致）
  // 示例：nir = 0.98906*nir_oli + 0.00004；swir1 = 0.99467*swir1_oli + 0.00256
  var nir_etm   = nir_oli.multiply(0.98906).add(0.00004);
  var swir1_etm = swir1_oli.multiply(0.99467).add(0.00256);

  return nir_etm.subtract(swir1_etm).divide(nir_etm.add(swir1_etm)).rename('NDWI');
}

function mosaicL7(ic7) {
  return ee.ImageCollection(ic7).mosaic();
}
// ========== 多年 NDWI 合成 ==========
// 获取三源影像集合（按 AOI 和时间过滤）
function getMonthlyNDWI(year, month, aoi) {
  var start = ee.Date.fromYMD(year, month, 1);
  var end   = start.advance(1, 'month');

  var ic5 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
      .filterDate(start, end).filterBounds(aoi)
      .map(ndwi_L57);

  var ic7 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
      .filterDate(start, end).filterBounds(aoi)
      .map(ndwi_L57);

  var ic8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
      .filterDate(start, end).filterBounds(aoi)
      .map(ndwi_L8);

  // 是否存在可用影像
  var has5 = ic5.size().gt(0);
  var has7 = ic7.size().gt(0);
  var has8 = ic8.size().gt(0);

  // 按存在性逐个添加，避免 null
  var imgs = ee.List([]);
  imgs = ee.List(ee.Algorithms.If(has5, imgs.add(ic5.median()), imgs));
  imgs = ee.List(ee.Algorithms.If(has7, imgs.add(mosaicL7(ic7)), imgs));
  imgs = ee.List(ee.Algorithms.If(has8, imgs.add(ic8.median()), imgs));

  var mergedIC = ee.ImageCollection.fromImages(imgs);
  var hasAny   = mergedIC.size().gt(0);

  return ee.Image(ee.Algorithms.If(
    hasAny,
    mergedIC.median()
      // 在任一源有值处保留像元，避免可视化空洞
      .updateMask(mergedIC.count().gt(0))
      .set({year: year, month: month, 'system:time_start': start.millis()}),
    null
  ));
}

// 构建“某年”的 1–12 月 NDWI 合集
function buildYearNDWI(year, aoi) {
  var list = ee.List.sequence(1, 12).map(function(m) {
    return getMonthlyNDWI(year, ee.Number(m), aoi);
  });
  return ee.ImageCollection(ee.List(list).removeAll([null]));
}

