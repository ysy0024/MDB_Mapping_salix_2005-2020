var phenoCol = ee.ImageCollection('MODIS/061/MCD12Q2')
  .filterBounds(geometry)
  .filter(ee.Filter.calendarRange(phenoStartYear, phenoEndYear, 'year'));

// 每一年的：Greenup_1 / Peak_1 / Dormancy_1 → 生成 3 个波段
var phenoPerYear = phenoCol.map(function(img) {
  // 可选：用 QA_Overall_1 做质量掩膜（只要 QA<=1 的高质量像元）
  // var qaMask = img.select('QA_Overall_1').lte(1);
  // img = img.updateMask(qaMask);

  var growLen = img.select('Dormancy_1')
                   .subtract(img.select('Greenup_1'))
                   .rename('GrowLength_year');

  var startDay = img.select('Greenup_1').rename('StartDay_year');
  var peakDay  = img.select('Peak_1').rename('PeakDay_year');

  return growLen.addBands(startDay).addBands(peakDay)
    .copyProperties(img, ['system:time_start']);
});

// 10 年内是否有有效数据
var phenoHasAny = phenoPerYear.size().gt(0);

