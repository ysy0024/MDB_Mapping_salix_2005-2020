/******************** NDVI 多源统一计算（L5/L7/L8） ********************/
// 统一 L2 掩膜（与 NDWI 一致）
function maskL2(img) {
  var qa = img.select('QA_PIXEL');
  var mask = qa.bitwiseAnd(1).eq(0)   // Fill=0
    .and(qa.bitwiseAnd(2).eq(0))      // Dilated cloud=0
    .and(qa.bitwiseAnd(8).eq(0))      // Cloud=0
    .and(qa.bitwiseAnd(16).eq(0))     // Shadow=0
    .and(qa.bitwiseAnd(32).eq(0));    // Snow=0
  return img.updateMask(mask);
}

// L5/L7：直接计算 NDVI（SR_B4: NIR, SR_B3: RED）
function addNDVI_L57(img) {
  img = maskL2(img);
  var nir = img.select('SR_B4').multiply(0.0000275).add(-0.2);
  var red = img.select('SR_B3').multiply(0.0000275).add(-0.2);
  var ndvi = nir.subtract(red).divide(nir.add(red)).rename('NDVI');
  return ndvi.copyProperties(img, img.propertyNames());
}

// L8：计算 NDVI（可选：在此处做 OLI→ETM+/TM 的波段等效）
// 说明：若你已有红、近红外的 L8→L7 系数，可在 red_oli、nir_oli 后按线性系数做一次等效再算 NDVI。
// 这里默认直接使用 OLI 反射率计算 NDVI，避免臆设系数。
function addNDVI_L8(img) {
  // Step 1: 统一 QA_PIXEL 掩膜
  img = maskL2(img);

  // Step 2: OLI → 反射率
  var red_OLI = img.select('SR_B4').multiply(0.0000275).add(-0.2);
  var nir_OLI = img.select('SR_B5').multiply(0.0000275).add(-0.2);

  // Step 3: OLI → ETM+ 等效反射率
  /*
  var red_ETM = red_OLI.multiply(0.9372).add(0.0123);
  var nir_ETM = nir_OLI.multiply(0.8339).add(0.0448);
  */
  var red_ETM = red_OLI.multiply(1.00446).add(0.00274);
  var nir_ETM = nir_OLI.multiply(0.98906).add(0.00004);
  // Step 4: NDVI（自动继承掩膜）
  var ndvi = nir_ETM.subtract(red_ETM)
    .divide(nir_ETM.add(red_ETM))
    .rename('NDVI')
    .clamp(-1, 1);

  // Step 5: 返回
  return ndvi.copyProperties(img, img.propertyNames());
}

