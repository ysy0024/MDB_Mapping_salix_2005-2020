var negativeSamples = Object.keys(filePaths).filter(function(k){ return k !== plantName; })
  .map(function(k){
    return ee.FeatureCollection(filePaths[k]).map(function(f){ return f.set(labelColumn, 0); });
  });
var allNegative = ee.FeatureCollection(negativeSamples).flatten();

// ====== 自动均衡采样（下采样负样本到与正样本同量）======
// 1) 计算数量
var posCount = plantData.size();
var negCount = allNegative.size();

// 2) 计算抽样比例（期望抽到 posCount 个负样本）
var frac = ee.Number(posCount).divide(negCount).min(1);

// 3) 用随机列按比例抽样，随后再 limit 到 posCount，确保严格对齐
var negativeBalanced = allNegative
  .randomColumn('neg_rand', 42)                    // 固定随机种子便于复现
  .filter(ee.Filter.lt('neg_rand', frac))
  .limit(posCount);                                // 精确控制上限 = 正样本数

// 4) 合并均衡后的数据
var mergedData = plantData.merge(negativeBalanced);

// （可选）打印检查
