/******************** EVI2 多源统一计算（L5/L7/L8）********************/

// L5/L7：直接计算 EVI2（SR_B4=NIR, SR_B3=RED）
function addEVI2_L57(img) {
  img = maskL2(img);
  var nir = img.select('SR_B4').multiply(0.0000275).add(-0.2);
  var red = img.select('SR_B3').multiply(0.0000275).add(-0.2);
  var evi2 = nir.subtract(red)
                .divide(nir.add(red.multiply(2.4)).add(1))
                .multiply(2.5)
                .rename('EVI2')
                .clamp(-1, 1);
  return evi2.copyProperties(img, img.propertyNames());
}

// L8：可选做 OLI→ETM+/TM 等效（与 NDVI 中用的系数一致）
function addEVI2_L8(img) {
  img = maskL2(img);
  var red_OLI = img.select('SR_B4').multiply(0.0000275).add(-0.2);
  var nir_OLI = img.select('SR_B5').multiply(0.0000275).add(-0.2);

  // 你在 NDVI 中使用的等效系数（示例，保持一致性）
  var red_ETM = red_OLI.multiply(1.00446).add(0.00274);
  var nir_ETM = nir_OLI.multiply(0.98906).add(0.00004);

  var evi2 = nir_ETM.subtract(red_ETM)
                    .divide(nir_ETM.add(red_ETM.multiply(2.4)).add(1))
                    .multiply(2.5)
                    .rename('EVI2')
                    .clamp(-1, 1);
  return evi2.copyProperties(img, img.propertyNames());
}

